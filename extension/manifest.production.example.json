{
  "manifest_version": 3,
  "name": "Ttalkak",
  "description": "TTALKAK Chrome side panel for improving prompts and sending them to AI tools.",
  "version": "1.0.0",
  "permissions": ["sidePanel", "scripting", "activeTab", "tabs", "clipboardWrite", "debugger", "storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://SPRING_BOOT_PRODUCTION_HOST/*"
  ],
  "action": {
    "default_title": "Ttalkak"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
