{
  "name": "ttalkak-chrome-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:shared": "node ../scripts/build-make-api-contract.cjs && node ../scripts/build-account-withdrawal-policy.cjs",
    "check:shared": "node ../scripts/check-make-api-contract.cjs && node ../scripts/check-account-withdrawal-policy.cjs",
    "test": "npm run test:node && npm run test:behavior",
    "test:node": "node --test test/*.test.js",
    "test:behavior": "vitest run --config vitest.config.js",
    "lint": "eslint src test scripts vite.config.js vitest.config.js eslint.config.js --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run check:shared && npm run lint && npm run typecheck && npm test && npm run build:verify",
    "dev": "vite --host 127.0.0.1",
    "build:dev": "node scripts/build-extension.mjs dev",
    "check:dev-identity": "node scripts/check-development-build-identity.mjs",
    "build": "npm run build:dev",
    "build:prod": "node scripts/build-extension.mjs prod",
    "build:verify": "node scripts/build-extension.mjs verify",
    "release:check": "node scripts/check-release-readiness.mjs",
    "release:prepare": "npm run verify && npm run build:prod && npm run release:check",
    "preview": "vite preview --mode development --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.8.0",
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.2",
    "@types/chrome": "^0.2.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.7"
  }
}
