# Copy to .env.merchant-review; never commit the populated file.
# Separate DB and JWT secrets only. Never use production credentials.
REVIEW_DB_PASSWORD=
REVIEW_JWT_SECRET_BASE64=
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
# Enable only for initial account creation. Disable and remove password after login verification.
MERCHANT_REVIEW_ACCOUNT_ENABLED=false
MERCHANT_REVIEW_ACCOUNT_PASSWORD=
