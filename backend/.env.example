MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ttalkak
MYSQL_PORT=3306

# 관리자 계정 자동 생성은 기본적으로 비활성화합니다.
# 사용할 때만 true로 변경하고 12자 이상의 비밀번호를 입력합니다.
ADMIN_SEED_ENABLED=false
ADMIN_USER_ID=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin
ADMIN_NAME=관리자

# 최소 32바이트의 무작위 값을 Base64로 인코딩해 사용합니다.
JWT_SECRET_BASE64=
JWT_EXPIRATION_MINUTES=120
JWT_ISSUER=ttalkak
