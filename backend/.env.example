MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ttalkak
MYSQL_PORT=3306

# 관리자 계정 자동 생성은 기본적으로 비활성화합니다.
# 사용할 때만 true로 변경하고 12자 이상의 비밀번호를 입력합니다.
ADMIN_SEED_ENABLED=false
ADMIN_USER_ID=admin
ADMIN_PASSWORD=
ADMIN_NICKNAME=admin
ADMIN_NAME=관리자

# 최소 32바이트의 무작위 값을 Base64로 인코딩해 사용합니다.
JWT_SECRET_BASE64=
JWT_EXPIRATION_MINUTES=120
JWT_ISSUER=ttalkak

# Google Identity Services 웹 클라이언트 ID
# 실제 값은 소스나 Git에 저장하지 않습니다.
GOOGLE_CLIENT_ID=

# CORS allowed origins, separated by commas
# Production Extension ID: dgbmmjembonnhfkknohmbhlepagicnpc
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,chrome-extension://dgbmmjembonnhfkknohmbhlepagicnpc