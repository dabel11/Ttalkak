{
  "name": "ttalkak-web-frontend",
  "private": true,
  "scripts": {
    "build:shared": "node ../scripts/build-make-api-contract.cjs && node ../scripts/build-make-message-model.cjs && node ../scripts/build-account-withdrawal-policy.cjs",
    "check:shared": "node ../scripts/check-make-api-contract.cjs && node ../scripts/check-make-message-model.cjs && node ../scripts/check-account-withdrawal-policy.cjs",
    "check:api": "node ../scripts/check-web-api-contracts.cjs",
    "check:bundle": "node ../scripts/check-web-bundle-size.cjs",
    "analyze:bundle": "node ../scripts/create-web-bundle-report.cjs",
    "check:globals": "node ../scripts/check-web-legacy-globals.cjs",
    "check:observability": "node ../scripts/check-web-observability.cjs",
    "build": "node ../scripts/build-web.cjs",
    "build:prod": "node ../scripts/build-web.cjs --production",
    "lint": "eslint src test e2e playwright.config.js playwright.integration.config.js playwright.production.config.js playwright.firefox.config.js preview-server.cjs",
    "typecheck": "tsc --project tsconfig.frontend.json",
    "typecheck:strict": "tsc --project tsconfig.strict.json",
    "test": "node --test test/*.test.js",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include=src/saved/*.mjs --test-coverage-include=src/discovery/*.mjs --test-coverage-include=src/home/home-search-model.mjs --test-coverage-include=src/interactions/comment-model.mjs --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=55 test/*.test.js",
    "test:coverage:state:all": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-*.mjs --test-coverage-lines=40 --test-coverage-branches=45 --test-coverage-functions=50 test/*.test.js",
    "test:coverage:state:admin": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-admin.mjs --test-coverage-lines=95 --test-coverage-branches=40 --test-coverage-functions=95 test/*.test.js",
    "test:coverage:state:persistence": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-persistence.mjs --test-coverage-lines=90 --test-coverage-branches=25 --test-coverage-functions=90 test/*.test.js",
    "test:coverage:state:prompt": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-prompt.mjs --test-coverage-lines=65 --test-coverage-branches=55 --test-coverage-functions=75 test/*.test.js",
    "test:coverage:state:critical": "npm run test:coverage:state:admin && npm run test:coverage:state:persistence && npm run test:coverage:state:prompt",
    "test:coverage:state": "npm run test:coverage:state:all && npm run test:coverage:state:critical",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:state",
    "test:e2e": "playwright test",
    "test:e2e:integration": "playwright test --config=playwright.integration.config.js",
    "test:e2e:firefox": "playwright test --config=playwright.firefox.config.js",
    "test:e2e:prod": "playwright test --config=playwright.production.config.js",
    "verify": "npm run check:shared && npm run check:api && npm run check:globals && npm run check:observability && npm run lint && npm run typecheck && npm run typecheck:strict && npm run test:coverage && npm run build:prod && npm run check:bundle && npm run analyze:bundle",
    "verify:full": "npm run verify && npm run test:e2e && npm run test:e2e:firefox && npm run test:e2e:prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "terser": "5.50.0",
    "typescript": "7.0.2"
  }
}
