{
  "name": "ttalkak-web-frontend",
  "private": true,
  "scripts": {
    "build:shared": "node ../scripts/build-make-message-model.cjs",
    "check:shared": "node ../scripts/check-make-message-model.cjs",
    "check:api": "node ../scripts/check-web-api-contracts.cjs",
    "build": "node ../scripts/build-web.cjs",
    "build:prod": "node ../scripts/build-web.cjs --production",
    "lint": "eslint src test e2e playwright.config.js playwright.production.config.js preview-server.cjs",
    "typecheck": "tsc --project tsconfig.frontend.json",
    "typecheck:strict": "tsc --project tsconfig.strict.json",
    "test": "node --test test/*.test.js",
    "test:coverage:core": "node --test --experimental-test-coverage --test-coverage-include=src/saved/*.js --test-coverage-include=src/discovery/*.js --test-coverage-include=src/home/home-search-model.js --test-coverage-include=src/interactions/comment-model.js --test-coverage-lines=70 --test-coverage-branches=60 --test-coverage-functions=55 test/*.test.js",
    "test:coverage:state:all": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-*.js --test-coverage-lines=40 --test-coverage-branches=45 --test-coverage-functions=50 test/*.test.js",
    "test:coverage:state:admin": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-admin.js --test-coverage-lines=95 --test-coverage-branches=40 --test-coverage-functions=95 test/*.test.js",
    "test:coverage:state:persistence": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-persistence.js --test-coverage-lines=90 --test-coverage-branches=25 --test-coverage-functions=90 test/*.test.js",
    "test:coverage:state:prompt": "node --test --experimental-test-coverage --test-coverage-include=src/state/state-prompt.js --test-coverage-lines=65 --test-coverage-branches=55 --test-coverage-functions=75 test/*.test.js",
    "test:coverage:state:critical": "npm run test:coverage:state:admin && npm run test:coverage:state:persistence && npm run test:coverage:state:prompt",
    "test:coverage:state": "npm run test:coverage:state:all && npm run test:coverage:state:critical",
    "test:coverage": "npm run test:coverage:core && npm run test:coverage:state",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test --config=playwright.production.config.js",
    "verify": "npm run check:shared && npm run check:api && npm run lint && npm run typecheck && npm run typecheck:strict && npm run test:coverage && npm run build:prod",
    "verify:full": "npm run verify && npm run test:e2e && npm run test:e2e:prod"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "esbuild": "0.28.2",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "typescript": "7.0.2"
  }
}
