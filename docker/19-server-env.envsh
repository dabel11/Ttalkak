#!/bin/sh
set -eu

# Official nginx sources executable *.envsh files before substituting templates.
case "$PORT" in ''|*[!0-9]*) echo 'PORT must be numeric' >&2; exit 1;; esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo 'PORT must be between 1 and 65535' >&2; exit 1
fi
case "$BACKEND_UPSTREAM" in ''|*[!a-zA-Z0-9.:-]*) echo 'BACKEND_UPSTREAM must be host:port' >&2; exit 1;; esac
case "$PROXY_READ_TIMEOUT" in ''|*[!0-9smh]) echo 'Invalid PROXY_READ_TIMEOUT' >&2; exit 1;; esac
resolver="${DNS_RESOLVER:-$(awk '/^nameserver / {print $2; exit}' /etc/resolv.conf)}"
case "$resolver" in ''|*[!a-zA-Z0-9.:%\[\]-]*) echo 'Invalid DNS resolver' >&2; exit 1;; esac
case "$resolver" in *:*) case "$resolver" in \[*\]) ;; *) resolver="[$resolver]";; esac;; esac
export DNS_RESOLVER="$resolver"

# Ensure the nginx template substitutes an empty value when the secret is not configured.
# Do not log or print the secret.
export TTALKAK_AUTH_PROXY_SECRET="${TTALKAK_AUTH_PROXY_SECRET:-}"
if [ -n "$TTALKAK_AUTH_PROXY_SECRET" ] && [ "${#TTALKAK_AUTH_PROXY_SECRET}" -lt 32 ]; then
    echo 'TTALKAK_AUTH_PROXY_SECRET must contain at least 32 characters' >&2
    exit 1
fi

case "$TTALKAK_AUTH_PROXY_SECRET" in
    *[!a-zA-Z0-9_-]*)
        echo 'TTALKAK_AUTH_PROXY_SECRET must use URL-safe ASCII characters only' >&2
        exit 1
        ;;
esac
