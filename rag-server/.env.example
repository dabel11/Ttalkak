# rag-server 환경변수 예시 — 복사해서 rag-server/.env 로 쓴다 (`.env` 는 git 미추적).
#   cp .env.example .env
# 코드가 읽는 변수 전부(app/ 기준)를 적었다. 주석 처리된 것은 선택.

# ── LLM 키 (둘 중 하나 이상 필수) ────────────────────────────
# 기본은 Groq 우선, Gemini 는 장문 라우팅·폴백. GEN_PRIMARY=gemini 로 메인을 바꾼다(아래).
GROQ_API_KEY=
GEMINI_API_KEY=

# ── 메인 생성 백엔드 ─────────────────────────────────────────
# groq(기본) | gemini. gemini 로 두면 생성기가 Gemini 를 메인으로 쓰고 Groq 는 폴백.
# 제미나이를 메인으로 쓰려면 결제 등급(Tier 1)이 필요하고 GEMINI_MODEL 로 모델을 고정한다.
# GEN_PRIMARY=gemini
# GEMINI_MODEL=gemini-3.6-flash      # 메인/폴백 공통으로 이 Gemini 모델을 쓴다(별칭 대신 고정)

# ── 분석기(1단계) 백엔드 ─────────────────────────────────────
# groq(기본, gpt-oss-20b) | gemini. 무료 Groq 20b 는 하루 ~90건에서 한도에 걸려 분석이 조용히
# 꺼지므로, 사용량이 늘면 생성기와 같은 제미나이로 통일한다.
# ANALYZER_BACKEND=gemini
# ANALYZER_MODEL=gemini-3.5-flash-lite   # 2.5-flash-lite 는 신규 계정 종료(404) → 3.5 가 후속
# ANALYZER_THINKING_BUDGET=512           # 형식 판단이라 사고 최소. 3.5-flash-lite 는 0 거부(512+)

# 무료 티어 밖(유료)이면 예산을 올린다. 미설정 = 무료 8,000 (gpt-oss 120b/20b 공통).
# 결제만 하고 이 값을 안 넣으면 출력 예산이 안 늘어난다(2026-09-20).
# GROQ_TPM_LIMIT=250000

# ── MySQL (RAG 벡터 저장소, Spring 과 동일 ttalkak DB) ────────
# 미설정 시 db.py 기본값: 127.0.0.1 / 3306 / ttalkak / root / root
# docker compose 로 띄우면 DB_HOST 등은 compose 가 덮어쓴다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ttalkak
DB_USER=root
DB_PASSWORD=root
# 또는 단일 DSN(우선 적용):
# RAG_DB_URL=mysql+pymysql://user:pw@host:3306/ttalkak?charset=utf8mb4

# ── /index 보호 ──────────────────────────────────────────────
# 설정하면 X-API-Key 헤더가 일치해야 인덱싱된다. **미설정이면 /index 자체가 503** (fail-closed).
# 저장소에 /index 를 부르는 코드는 없다(적재는 ingestion/* 가 DB 직접 기록) — 안 써도 된다.
# RAG_INDEX_API_KEY=

# ── 동시 실행 게이트 (app/core/concurrency.py) ───────────────
# 동시성 기본값은 메인 백엔드 자동 적용: GEN_PRIMARY=gemini 면 6, Groq/미설정이면 1(직렬).
# 아래로 명시하면 그 값이 우선. 셋은 함께 고른다(대기상한 ≈ 줄길이 × 1건 처리시간, 합 < 75초).
# RAG_MAX_CONCURRENT_GEN=6
# RAG_GEN_QUEUE_WAIT=40
# RAG_GEN_QUEUE_DEPTH=2

# ── LLM 타임아웃(초) (app/core/timeouts.py) ──────────────────
# RAG_LLM_TIMEOUT_FAST=20   # 분석기·쿼리변환
# RAG_LLM_TIMEOUT_GEN=45    # 생성기

# ── CPU 추론 스레드 (app/core/embeddings.py) ─────────────────
# 미설정이면 os.cpu_count() 전체 사용(리랭커·임베딩 CPU 속도 ↑, 품질 불변). 상한 지정 시만 설정.
# RAG_TORCH_THREADS=10

# ── 생성 튜닝 — A/B 용 토글. 측정 없이 켜지 말 것 ────────────
# GEN_TEMPERATURE=0.7
# GEN_REASONING_EFFORT=low      # low|medium|high, 미설정 = 모델 기본
# GEMINI_MODEL=gemini-flash-latest   # 요청 model 이 무료 불가일 때 대체할 Gemini 모델
